classDiagram
  direction LR

  class App {
    +state: object
    +fetchData(): Promise<void>
    +handleAgentQuery(query: string, customData: object): Promise<void>
    +render(): JSX.Element
  }

  class Server {
    +app: Express.Application
    +PORT: number
    +ai: GoogleGenAI | null
    +currentBrent: number
    +currentTtf: number
    +currentSelic: number
    +mockLogs: LogEntry[]
    +mockThreads: Thread[]
    +startServer(): Promise<void>
    +getDb(): Database
    +initDb(): Promise<void>
    +savePrice(asset: string, price: number, timestamp?: string): Promise<void>
    +getHistoricalPrices(asset: string, limit: number): Promise<PriceEntry[]>
    +seedFromPublicApis(): Promise<void>
  }

  class Database {
    +dbInstance: any
    +getDb(): Database
    +initDb(): Promise<void>
    +savePrice(asset: string, price: number, timestamp?: string): Promise<void>
    +getHistoricalPrices(asset: string, limit: number): Promise<PriceEntry[]>
    +seedFromPublicApis(): Promise<void>
  }

  class GoogleGenAI {
    +apiKey: string
    +models: object
    +generateContent(params: object): Promise<object>
  }

  class WebSpeechAPI {
    +speak(text: string, force: boolean, onStart?: Function, onEnd?: Function): void
    +cancelSpeech(): void
    +setMuteState(muted: boolean): void
    +getMuteState(): boolean
  }

  class IndicadoresMacro {
    +simulateMonteCarlo(currentPrice: number, days: number, numPaths: number): number[][]
    +calculateTaylorRule(inflation: number, outputGap: number): number
  }

  App --|> IndicadoresMacro: uses
  App --|> WebSpeechAPI: uses
  App --|> Server: calls API endpoints
  Server --|> Database: uses
  Server --|> GoogleGenAI: uses (conditionally)
  Server --|> WebSpeechAPI: uses (via frontend)
  Database --|> YahooFinanceAPI: fetches from
  Database --|> BCBAPI: fetches from

  class LogEntry {
    +id: string
    +timestamp: string
    +level: string
    +category: string
    +message: string
  }

  class Thread {
    +id: string
    +timestamp: string
    +posts: Post[]
    +likes: number
    +reposts: number
    +replies: number
    +automated: boolean
  }

  class Post {
    +text: string
  }

  class PriceEntry {
    +price: number
    +timestamp: string
  }

  Server .. LogEntry: manages
  Server .. Thread: manages
  Thread --* Post: contains
  Database .. PriceEntry: stores
