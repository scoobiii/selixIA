direction: right

// Actors
user -> mobile_device: Acessa via navegador

// Mobile Device (Samsung A23 / Termux)
mobile_device: {
  shape: cylinder
  label: "Samsung A23 (Termux)"

  subgraph termux_env {
    label: "Ambiente Termux"
    node_js: {
      label: "Node.js Runtime"
      shape: rectangle
    }
    express_server: {
      label: "Express.js Server (BFF)"
      shape: rectangle
    }
    react_frontend: {
      label: "React Frontend (Vite)"
      shape: rectangle
    }
    sqlite_db: {
      label: "SQLite DB (selix.db)"
      shape: rectangle
    }
    web_speech_api: {
      label: "Web Speech API"
      shape: rectangle
    }

    node_js -> express_server
    express_server <-> react_frontend: HTTP/JSON
    express_server <-> sqlite_db: SQL
    react_frontend -> web_speech_api: TTS
  }
}

// External Services
external_apis: {
  label: "APIs Externas"
  shape: cloud
  yahoo_finance: {
    label: "Yahoo Finance"
    shape: rectangle
  }
  bcb_api: {
    label: "BCB API"
    shape: rectangle
  }
  google_gemini_api: {
    label: "Google Gemini API"
    shape: rectangle
  }

  external_apis -> yahoo_finance
  external_apis -> bcb_api
  external_apis -> google_gemini_api
}

// Connections
express_server <-> google_gemini_api: HTTPS (condicional, via GEMINI_API_KEY)
express_server <-> yahoo_finance: HTTPS (crawler)
express_server <-> bcb_api: HTTPS (crawler)


subgraph public_access {
  label: "Acesso Público e Redundância (Proposto)"
  direction: right

  mobile_device_2: {
    shape: cylinder
    label: "Samsung A23 (Termux) - Redundância"
  }

  cloudflare_tunnel: {
    label: "Cloudflare Tunnels (cloudflared)"
    shape: rectangle
  }

  load_balancer: {
    label: "Balanceador de Carga (Cloudflare/AWS)"
    shape: hexagon
  }

  user_public -> load_balancer: Acessa via URL pública
  load_balancer <-> cloudflare_tunnel
  cloudflare_tunnel <-> mobile_device: Tunelamento
  cloudflare_tunnel <-> mobile_device_2: Tunelamento
}

// Intelligence Flow
react_frontend -> express_server: Consulta do usuário
express_server -> google_gemini_api: Consulta LLM (se API Key presente)
express_server -> express_server: Fallback Heurístico (se API Key ausente)
google_gemini_api --> express_server: Resposta LLM
express_server --> react_frontend: Resposta Analítica

// Voice Flow
react_frontend -> web_speech_api: Texto para Fala
web_speech_api -> mobile_device: Áudio
